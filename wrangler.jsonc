{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocket-bot-web",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
